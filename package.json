{
  "name": "dota-mate",
  "version": "1.0.0",
  "description": "Личный справочник союзников по Dota 2: вход через Steam, матчи из OpenDota, приватные оценки и заметки",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "python3 tests/e2e/rep_e2e.py && python3 tests/e2e/assistant_e2e.py"
  },
  "engines": {
    "node": ">=18 (для сообщества: >=22.5)"
  }
}
