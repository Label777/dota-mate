# Dota Mate: пример переменных окружения. Скопируйте в .env или задайте в панели хостинга.
# Файл .env в репозиторий не коммитьте. Секреты на странице сайта не попадают.

# Порт и публичный адрес сайта (для Steam OpenID нужен именно тот адрес, по которому сайт открывают)
PORT=3000
PUBLIC_URL=https://example.com

# Подпись сессий. Если пусто, сервер сам создаёт ключ в DATA_DIR/secret.key
SESSION_SECRET=

# Где хранить данные: JSON пользователей и база сообщества (SQLite)
DATA_DIR=./data
# Необязательно: отдельный путь к файлу базы (по умолчанию DATA_DIR/dotamate.sqlite)
DB_FILE=

# Модераторы: Steam ID или SteamID64 через запятую. Без этого модерация недоступна ни кому.
MODERATORS=

# Необязательно: ключ OpenDota повышает лимиты запросов (в браузер не передаётся)
OPENDOTA_API_KEY=
# Необязательно: ключ Steam Web API нужен только для ссылок вида steamcommunity.com/id/имя
STEAM_API_KEY=

# Только для тестов и локальной проверки. В боевой среде НЕ включать.
DEV_LOGIN=0
# Только для тестов: другой адрес источника данных вместо https://api.opendota.com/api
OPENDOTA_BASE=
